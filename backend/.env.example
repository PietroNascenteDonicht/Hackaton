# ==========================================
# APLICACAO
# ==========================================
APP_NAME="hackathon"
APP_ENV=development
APP_DEBUG=
APP_URL=http://localhost
APP_LOG_FILE=storage/logs/app.log

# ==========================================
# BANCO DE DADOS - MYSQL / MARIADB
# ==========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hackaton
DB_USER=root
DB_PASS=

# ==========================================
# CORS - ORIGENS AUTORIZADAS
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ==========================================
# API
# ==========================================
API_PREFIX=/api
